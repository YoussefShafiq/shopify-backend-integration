PORT=3300
NODE_ENV=dev
DB_URL=mongodb://localhost:27017/shopify-integration
USER_ACCESS_SECRET_KEY=
USER_REFRESH_SECRET_KEY=
ADMIN_ACCESS_SECRET_KEY=
ADMIN_REFRESH_SECRET_KEY=
ENCRYPTION_SECRET=

EMAIL_USER=
EMAIL_PASS=

WEB_CLIENT_ID=

REDIS_URL=

# Shopify Admin API (store you own + Dev Dashboard app with client credentials)
SHOPIFY_API_URL=https://your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Webhook HMAC (API secret key — not the Admin access token)
SHOPIFY_WEBHOOK_SECRET=
# Dev-only: skip webhook HMAC verification
SKIP_SHOPIFY_WEBHOOK_HMAC=0

# Optional fallback if not using client credentials:
# SHOPIFY_ACCESS_TOKEN=
